    "paragraphCount": 1744,
    "matches": [
      {
        "paragraphIndexNotPage": 180,
        "text": "Đánh giá đã xác minh mua hàng, phí sàn 5%, đối soát mô phỏng"
      },
      {
        "paragraphIndexNotPage": 198,
        "text": "5% giá trị đơn con, chốt lúc tạo đơn"
      },
      {
        "paragraphIndexNotPage": 260,
        "text": "Hồ sơ APPROVED; một store/seller; slug duy nhất."
      },
      {
        "paragraphIndexNotPage": 324,
        "text": "Chỉ PAID sau DELIVERED; xác nhận lặp không ghi thêm; xử lý thay chỉ đúng phạm vi."
      },
      {
        "paragraphIndexNotPage": 340,
        "text": "DELIVERED mở quyền bằng event; một review/món/đơn; review HIDDEN không tính điểm."
      },
      {
        "paragraphIndexNotPage": 348,
        "text": "Bốn nhóm số liệu; chốt phí 5%, house store 0%; DELIVERED + PAID mới đối soát."
      },
      {
        "paragraphIndexNotPage": 378,
        "text": "Hồ sơ duyệt và một store mỗi seller"
      },
      {
        "paragraphIndexNotPage": 447,
        "text": "orders + seller_orders cùng transaction PENDING; PLACED; phí 5% / house 0%"
      },
      {
        "paragraphIndexNotPage": 487,
        "text": "Dùng seller-order.status-changed.v1 thay vì thêm topic delivered riêng"
      },
      {
        "paragraphIndexNotPage": 488,
        "text": "F14/F15; product-service lọc DELIVERED; consumer xử lý lặp và DLT."
      },
      {
        "paragraphIndexNotPage": 585,
        "text": "DELIVERED event; /api/products/{id}/reviews; hide/unhide"
      },
      {
        "paragraphIndexNotPage": 756,
        "text": "- Phí sàn 5% (house store 0%) chốt cùng số tiền khi tạo đơn con. Đủ điều kiện đối soát khi đã giao ∧ đã thu COD."
      },
      {
        "paragraphIndexNotPage": 836,
        "text": "Bốn nhóm doanh thu và phí sàn 5% của cửa hàng"
      },
      {
        "paragraphIndexNotPage": 911,
        "text": "Món thuộc đơn con của khách đã DELIVERED; chưa đánh giá món này trong đơn này"
      },
      {
        "paragraphIndexNotPage": 993,
        "text": "Đơn con đã DELIVERED, COD UNPAID"
      },
      {
        "paragraphIndexNotPage": 1063,
        "text": "Quan hệ 1:N và 1:0..1 bằng đường liền thể hiện liên kết khóa ngoại trong cùng database. Đường đứt từ seller_orders đến reviewable_items biểu diễn đồng bộ bằng event DELIVERED giữa order_db và product_db. Order_items xác định đơn con tương ứng qua cặp order_id và store_id."
      },
      {
        "paragraphIndexNotPage": 1088,
        "text": "orders, order_items, seller_orders, seller_order_status_history, settlements, order_outbox"
      },
      {
        "paragraphIndexNotPage": 1106,
        "text": "settlements"
      },
      {
        "paragraphIndexNotPage": 1107,
        "text": "Đối soát một đơn con hai lần"
      },
      {
        "paragraphIndexNotPage": 1114,
        "text": "CHECK: COD PAID chỉ khi DELIVERED và có paid_at, paid_by"
      },
      {
        "paragraphIndexNotPage": 1255,
        "text": "toStatus = DELIVERED"
      },
      {
        "paragraphIndexNotPage": 1465,
        "text": "Mỗi người bán có một cửa hàng"
      },
      {
        "paragraphIndexNotPage": 1601,
        "text": "Một đơn con cho mỗi cửa hàng"
      },
      {
        "paragraphIndexNotPage": 1622,
        "text": "commission_amount, seller_net"
      }
