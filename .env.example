# Local development only. Copy to .env (ignored), fill each value independently.
# Existing volume: use its CURRENT administrator password; this does not rotate it.
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
AUTH_MIGRATION_PASSWORD=
USER_DB_PASSWORD=
USER_MIGRATION_PASSWORD=
# Optional: choose a free local port; set both service ports to the same value.
POSTGRES_PORT=5432
AUTH_DB_PORT=5432
USER_DB_PORT=5432
